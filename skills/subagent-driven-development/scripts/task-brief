#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2

if [ $# -eq 3 ]; then
  out=$3
elif [ -f "$plan" ]; then
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
else
  # A prior default brief can outlive a deleted plan. Reconstruct its path so
  # this failed regeneration can invalidate it before reporting the missing
  # input. Do not create a workspace for a plan that does not exist.
  slug=$(basename "$plan" .md)
  [ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
    || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }
  root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "no such plan file: $plan" >&2; exit 2; }
  out="$root/.superpowers/sdd/$slug/task-${n}-brief.md"
fi

# Invalidate any previous brief before parsing. If regeneration fails, callers
# must see an empty artifact rather than accidentally executing stale authority.
if [ -e "$out" ]; then : > "$out"; fi
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
: > "$out"

task_tmp=$(mktemp)
render_tmp=""
cleanup() {
  rm -f "$task_tmp"
  if [ -n "$render_tmp" ]; then
    rm -f "$render_tmp"
  fi
}
trap cleanup EXIT

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$plan" > "$task_tmp"

if [ ! -s "$task_tmp" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

if ! awk '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ { exit }
  !infence && /^\*\*Authority Model:\*\*[ \t]*typed-v1[ \t]*$/ { found = 1 }
  END { exit !found }
' "$plan"; then
  mv "$task_tmp" "$out"
  task_tmp=""
  echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
  exit 0
fi

for field in "Contract Coverage" "Enables Evidence" "Forbidden Scope" "Design Defaults"; do
  if ! grep -q "^\\*\\*${field}:\\*\\*[[:space:]]*" "$task_tmp"; then
    echo "typed-v1 task ${n} in ${plan} is missing '${field}'" >&2
    exit 4
  fi
done

spec_line=$(awk '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ { exit }
  !infence && /^\*\*Spec:\*\*[ \t]*[^ \t]/ { print; exit }
' "$plan")
if [ -z "$spec_line" ]; then
  echo "typed-v1 plan ${plan} is missing an inline '**Spec:** <path>' before its tasks" >&2
  exit 4
fi

authority_model=$(awk '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ { exit }
  !infence && /^\*\*Authority Model:\*\*/ { print; exit }
' "$plan")

field_value() {
  field_name=$1
  sed -n "s/^\\*\\*${field_name}:\\*\\*[[:space:]]*//p" "$task_tmp" | head -1
}

contract_value=$(field_value "Contract Coverage")
evidence_value=$(field_value "Enables Evidence")
forbidden_value=$(field_value "Forbidden Scope")
defaults_value=$(field_value "Design Defaults")

ids_from() {
  printf '%s\n' "$1" | grep -Eo '(HC|BI|NG|DE|DD)-[0-9]+' | sort -u | tr '\n' ' '
}

is_explicit_none() {
  local normalized
  normalized=$(printf '%s\n' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [ "$normalized" = "None" ] || [ "$normalized" = "None." ]
}

validate_authority_field() {
  local label=$1
  local value=$2
  local allowed_prefixes=$3
  local allow_none=$4
  local all_ids allowed_ids none_note=""

  if [ "$allow_none" = "yes" ] && is_explicit_none "$value"; then
    return 0
  fi

  all_ids=$(ids_from "$value" || true)
  allowed_ids=$(printf '%s\n' "$value" | grep -Eo "(${allowed_prefixes})-[0-9]+" | sort -u | tr '\n' ' ' || true)

  if [ -z "$value" ] || [ -z "$allowed_ids" ] || [ "$all_ids" != "$allowed_ids" ]; then
    if [ "$allow_none" = "yes" ]; then none_note=" or explicit None"; fi
    echo "typed-v1 task ${n} in ${plan} has invalid '${label}'; expected ${allowed_prefixes//|/ or }-* IDs${none_note}" >&2
    exit 4
  fi
}

validate_authority_field "Contract Coverage" "$contract_value" "HC|BI" "no"
validate_authority_field "Enables Evidence" "$evidence_value" "DE" "yes"
validate_authority_field "Forbidden Scope" "$forbidden_value" "NG" "yes"
validate_authority_field "Design Defaults" "$defaults_value" "DD" "yes"

contract_ids=$(ids_from "$contract_value" || true)
evidence_ids=$(ids_from "$evidence_value" || true)
forbidden_ids=$(ids_from "$forbidden_value" || true)

extract_referenced_lines() {
  refs=$1
  awk -v refs=" $refs" '
    /^```/ { infence = !infence }
    !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ { exit }
    !infence && match($0, /(HC|BI|NG|DE)-[0-9]+/) {
      id = substr($0, RSTART, RLENGTH)
      if (index(refs, " " id " ")) print
    }
  ' "$plan"
}

contract_lines=$(extract_referenced_lines "$contract_ids")
evidence_lines=$(extract_referenced_lines "$evidence_ids")
forbidden_lines=$(extract_referenced_lines "$forbidden_ids")

referenced_count() {
  printf '%s\n' "$1" | awk '{ for (i = 1; i <= NF; i++) count++ } END { print count + 0 }'
}

line_count() {
  if [ -z "$1" ]; then
    printf '0\n'
  else
    printf '%s\n' "$1" | wc -l | tr -d ' '
  fi
}

if [ "$(line_count "$contract_lines")" -ne "$(referenced_count "$contract_ids")" ]; then
  echo "typed-v1 task ${n} in ${plan} cites missing HC-* or BI-* authority" >&2
  exit 4
fi
if [ "$(line_count "$evidence_lines")" -ne "$(referenced_count "$evidence_ids")" ]; then
  echo "typed-v1 task ${n} in ${plan} cites missing DE-* evidence" >&2
  exit 4
fi
if [ "$(line_count "$forbidden_lines")" -ne "$(referenced_count "$forbidden_ids")" ]; then
  echo "typed-v1 task ${n} in ${plan} cites missing NG-* scope" >&2
  exit 4
fi

deviation_policy=$(awk '
  /^```/ { infence = !infence }
  !infence && /^##+[ \t]+Deviation Policy[ \t]*$/ { inpolicy = 1; next }
  inpolicy && !infence && (/^---[ \t]*$/ || /^#+[ \t]+Task[ \t]+[0-9]+/) { exit }
  inpolicy && NF { print }
' "$plan")
if [ -z "$deviation_policy" ]; then
  echo "typed-v1 plan ${plan} is missing a Deviation Policy before its tasks" >&2
  exit 4
fi

render_tmp=$(mktemp)
{
  printf '# Authority Prelude\n\n'
  printf '%s\n' "$authority_model"
  printf '%s\n\n' "$spec_line"
  printf '## Normative Authority\n\n%s\n\n' "$contract_lines"
  printf '## Relevant Non-goals\n\n'
  if [ -n "$forbidden_lines" ]; then printf '%s\n' "$forbidden_lines"; else printf -- '- None.\n'; fi
  printf '\n## Required Evidence\n\n'
  if [ -n "$evidence_lines" ]; then printf '%s\n' "$evidence_lines"; else printf -- '- None.\n'; fi
  printf '\n## Design Defaults\n\n- %s\n\n' "$defaults_value"
  printf '## Deviation Policy\n\n%s\n\n---\n\n' "$deviation_policy"
  cat "$task_tmp"
} > "$render_tmp"

mv "$render_tmp" "$out"
render_tmp=""

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
